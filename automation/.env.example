# ── Apify ──────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxx
# Actor ID for TikTok scraper
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper

# ── Google Service Account ─────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
# 2. Create service account → download JSON key
# 3. Enable APIs: Drive API, Sheets API, Docs API
# 4. Share your Google Drive folder with the service account email
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# Optional: Google Drive parent folder ID (leave blank for My Drive root)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ── Gemini ─────────────────────────────────────────────────────────────────
# Get API key at aistudio.google.com
GEMINI_API_KEY=AIzaSyxxxxxxxxxx
# Model for video analysis (gemini-1.5-pro has 1M context window)
GEMINI_MODEL=gemini-1.5-pro

# ── Notifications (both optional — leave blank to disable) ─────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
