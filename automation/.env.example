# ── Apify ──────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxx
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper

# ── Google Auth (choose ONE) ──────────────────────────────────────────────
#
# OPTION 1 — Personal Gmail (recommended):
#   1. console.cloud.google.com -> APIs & Services -> Credentials
#   2. Create OAuth 2.0 Client ID (Desktop app) -> download JSON
#   3. Save as automation/client_secret.json
#   4. Enable APIs: Drive, Sheets, Docs
#   5. Add your Gmail to Test Users (OAuth consent screen)
#   6. Run: python setup_oauth.py
#   Token is saved to token.json automatically.
OAUTH_TOKEN_JSON=token.json
#
# OPTION 2 — Google Workspace (service account):
#   Only works with Shared Drives or domain-wide delegation.
#   Personal Gmail CANNOT upload binary files via service account.
# GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Your email — used to share files when running via service account
USER_EMAIL=

# Google Drive parent folder ID (leave blank for My Drive root)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ── Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyxxxxxxxxxx
# gemini-2.5-flash (fast, cheap) or gemini-2.5-pro (deeper analysis)
GEMINI_MODEL=gemini-2.5-flash

# ── Notifications (both optional) ─────────────────────────────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
